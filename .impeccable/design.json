      "css": ".ds-chart{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,sans-serif;border:1px solid var(--pave-line, #e0e6ef);border-radius:var(--pave-radius, 14px);background:var(--pave-surface, #ffffff);padding:1.5rem;}.ds-chart h3{color:var(--pave-ink, #182337);font-size:1rem;font-weight:650;margin:0 0 1.5rem;}.ds-bar-row{display:grid;grid-template-columns:minmax(110px,1.3fr) minmax(70px,1.4fr) 58px 42px;gap:1rem;align-items:center;}.ds-bar-label{font-size:.8125rem;color:#394b65;line-height:1.4;overflow-wrap:anywhere;}.ds-track{height:10px;background:#edf2f9;border-radius:3px;overflow:hidden;}.ds-fill{height:100%;width:100%;background:var(--pave-blue, #2563eb);border-radius:3px;}.ds-count{font-size:.8125rem;color:var(--pave-ink, #182337);font-weight:600;text-align:right;font-variant-numeric:tabular-nums;}.ds-share{font-size:.75rem;color:var(--pave-muted, #59677c);text-align:right;font-variant-numeric:tabular-nums;}@media(max-width:1099px){.ds-share{display:none;}.ds-bar-row{grid-template-columns:minmax(110px,1.4fr) minmax(40px,1fr) 45px;gap:.75rem;}}",
