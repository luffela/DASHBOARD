      "name": "Download button",
      "kind": "button",
      "description": "Native secondary download button; computed default from Streamlit 1.65.",
      "html": "<button class=\"ds-download\">Download processed CSV</button>",
      "css": ".ds-download{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,sans-serif;background:rgb(252,252,253);color:var(--pave-ink, #182337);border:1px solid rgba(24,35,55,.2);border-radius:8px;padding:4px 12px;font-size:13px;font-weight:600;line-height:20.8px;transition:background-color 160ms ease-out,border-color 160ms ease-out;}.ds-download:hover{border-color:var(--pave-blue, #2563eb);background:#eff5ff;}.ds-download:focus-visible{outline:2px solid var(--pave-blue, #2563eb);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-download{transition:none;}}",
      "refersTo": "button-download"
    },
    {
      "name": "Text field",
      "kind": "input",
      "description": "Native text field shape, label, and focus treatment.",
      "html": "<label class=\"ds-label\" for=\"ds-location\">Project Location</label><div class=\"ds-field\"><input id=\"ds-location\"></div>",
      "css": ".ds-label{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,sans-serif;display:block;color:var(--pave-ink, #182337);font-size:.8125rem;font-weight:600;margin-bottom:.5rem;}.ds-field{border:1px solid #8491a5;border-radius:8px;background:var(--pave-surface, #ffffff);}.ds-field input{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,sans-serif;min-height:42px;width:90%;border:0;background:transparent;color:var(--pave-ink, #182337);font-size:.875rem;padding:0 12px;caret-color:var(--pave-blue, #2563eb);}.ds-field input::placeholder{color:#69768a;opacity:1;}.ds-field:focus-within{border-color:var(--pave-blue, #2563eb);}.ds-field input:focus-visible{outline:2px solid var(--pave-blue, #2563eb);outline-offset:3px;}",
      "refersTo": "text-field"
    },
    {
      "name": "Result tabs",
      "kind": "nav",
      "description": "Visual specimen of the three Streamlit result tabs; app switching is provided by Streamlit.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Traffic overview</button><button role=\"tab\" aria-selected=\"false\">Uploaded Traffic Data</button><button role=\"tab\" aria-selected=\"false\">Calculation details</button></div>",
      "css": ".ds-tabs{display:flex;gap:1.5rem;border-bottom:1px solid var(--pave-line, #e0e6ef);}.ds-tabs button{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,sans-serif;font-size:.875rem;font-weight:600;height:44px;padding:0;background:transparent;border:0;color:var(--pave-ink, #182337);white-space:nowrap;}.ds-tabs button[aria-selected=true]{color:var(--pave-blue, #2563eb);border-bottom:2px solid var(--pave-blue, #2563eb);}.ds-tabs button:hover{color:var(--pave-blue, #2563eb);}.ds-tabs button:focus-visible{outline:2px solid var(--pave-blue, #2563eb);outline-offset:3px;}@media(max-width:480px){.ds-tabs{gap:1.25rem;}}"
    },
